<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Yahtzee.Models"
             xmlns:pageModels="clr-namespace:Yahtzee.PageModels"
             x:Class="Yahtzee.Pages.GamePage"
             x:DataType="pageModels:GamePageModel"
             Title="Game">
    <ContentPage.Resources>
        <!-- One row of the scorecard, shared by both columns. -->
        <DataTemplate x:Key="ScoreRowTemplate"
                      x:DataType="models:ScoreCategory">
            <Grid ColumnDefinitions="*,Auto"
                  Padding="14,10">
                <Label Grid.Column="0"
                       Text="{Binding Name}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsDerived}"
                                     Value="True">
                            <Setter Property="FontAttributes" Value="Bold" />
                            <Setter Property="FontSize" Value="15" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label Grid.Column="1"
                       Text="{Binding DisplayScore}"
                       HorizontalOptions="End">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsDerived}"
                                     Value="True">
                            <Setter Property="FontAttributes" Value="Bold" />
                            <Setter Property="FontSize" Value="15" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="18">
        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Dice}"
                               Spacing="8"
                               HorizontalOptions="Center">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:Die">
                    <Border WidthRequest="56"
                                        HeightRequest="60"
                                        Padding="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray800}}"
                                        Stroke="{StaticResource Gray300}"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:GamePageModel}}, Path=ToggleHoldCommand}"
                                                              CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                                     Binding="{Binding IsHeld}"
                                                     Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                <Setter Property="StrokeThickness" Value="4" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Glyph}"
                                           FontSize="46"
                                           VerticalTextAlignment="Center"
                                           TranslationY="-3"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsHeld}"
                                             Value="True">
                                    <Setter Property="TranslationY" Value="-6" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>

        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
            <!-- Spans both columns so the button centres on the row itself, not on the space the lights leave over. -->
            <Button Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="Roll Dice"
                    Command="{Binding RollCommand}"
                    FontAttributes="Bold"
                    HeightRequest="40"
                    Padding="16,0"
                    HorizontalOptions="Center" />

            <!-- Rolls left for this turn: one light per roll, emptying from the right as each is used. -->
            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="8"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center">
                <BoxView WidthRequest="24"
                         HeightRequest="24"
                         CornerRadius="12"
                         BackgroundColor="Transparent"
                         Color="Transparent">
                    <BoxView.Triggers>
                        <DataTrigger TargetType="BoxView"
                                     Binding="{Binding IsFirstRollAvailable}"
                                     Value="True">
                            <Setter Property="Color"
                                    Value="{AppThemeBinding Light={StaticResource Green}, Dark={StaticResource GreenDark}}" />
                        </DataTrigger>
                    </BoxView.Triggers>
                </BoxView>
                <BoxView WidthRequest="24"
                         HeightRequest="24"
                         CornerRadius="12"
                         BackgroundColor="Transparent"
                         Color="Transparent">
                    <BoxView.Triggers>
                        <DataTrigger TargetType="BoxView"
                                     Binding="{Binding IsSecondRollAvailable}"
                                     Value="True">
                            <Setter Property="Color"
                                    Value="{AppThemeBinding Light={StaticResource Green}, Dark={StaticResource GreenDark}}" />
                        </DataTrigger>
                    </BoxView.Triggers>
                </BoxView>
                <BoxView WidthRequest="24"
                         HeightRequest="24"
                         CornerRadius="12"
                         BackgroundColor="Transparent"
                         Color="Transparent">
                    <BoxView.Triggers>
                        <DataTrigger TargetType="BoxView"
                                     Binding="{Binding IsThirdRollAvailable}"
                                     Value="True">
                            <Setter Property="Color"
                                    Value="{AppThemeBinding Light={StaticResource Green}, Dark={StaticResource GreenDark}}" />
                        </DataTrigger>
                    </BoxView.Triggers>
                </BoxView>
            </HorizontalStackLayout>
        </Grid>

        <Border Stroke="{StaticResource Gray300}"
                    StrokeShape="RoundRectangle 12"
                    Padding="0">
            <VerticalStackLayout>
                <!-- Upper section on the left, combinations on the right. -->
                <Grid ColumnDefinitions="*,1,*">
                    <VerticalStackLayout Grid.Column="0"
                                             BindableLayout.ItemsSource="{Binding UpperSection}"
                                             BindableLayout.ItemTemplate="{StaticResource ScoreRowTemplate}" />
                    <BoxView Grid.Column="1"
                                 Color="{StaticResource Gray300}" />
                    <VerticalStackLayout Grid.Column="2"
                                             BindableLayout.ItemsSource="{Binding LowerSection}"
                                             BindableLayout.ItemTemplate="{StaticResource ScoreRowTemplate}" />
                </Grid>

                <!-- The grand total spans both columns and closes the scoreboard. -->
                <BoxView HeightRequest="1"
                             Color="{StaticResource Gray300}" />
                <Grid ColumnDefinitions="*,Auto"
                          Padding="14,12">
                    <Label Grid.Column="0"
                               Text="{Binding GrandTotal.Name}"
                               FontAttributes="Bold"
                               FontSize="14" />
                    <Label Grid.Column="1"
                               Text="{Binding GrandTotal.DisplayScore}"
                               FontAttributes="Bold"
                               FontSize="14"
                               HorizontalOptions="End" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>
