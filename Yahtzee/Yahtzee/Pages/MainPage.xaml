<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:Yahtzee.PageModels"             
             xmlns:models="clr-namespace:Yahtzee.Models"
             xmlns:controls="clr-namespace:Yahtzee.Pages.Controls"
             xmlns:pullToRefresh="clr-namespace:Syncfusion.Maui.Toolkit.PullToRefresh;assembly=Syncfusion.Maui.Toolkit"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Yahtzee.Pages.MainPage"
             x:DataType="pageModels:MainPageModel"
             x:Name="OverviewPage"
             Title="">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
                BindingContext="{Binding Path=BindingContext, Source={x:Reference OverviewPage}, x:DataType=ContentPage}"
                EventName="NavigatedTo"
                Command="{Binding NavigatedToCommand}" />
        <toolkit:EventToCommandBehavior
                BindingContext="{Binding Path=BindingContext, Source={x:Reference OverviewPage}, x:DataType=ContentPage}"
                EventName="NavigatedFrom"
                Command="{Binding NavigatedFromCommand}" />
        <toolkit:EventToCommandBehavior
                BindingContext="{Binding Path=BindingContext, Source={x:Reference OverviewPage}, x:DataType=ContentPage}"
                EventName="Appearing"                
                Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="{StaticResource LayoutPadding}"
                         Spacing="{StaticResource LayoutSpacing}">
        <Image Source="yahtzee_logo.svg"
               Aspect="AspectFit"
               HeightRequest="110"
               HorizontalOptions="Center"
               SemanticProperties.Description="Yahtzee logo" />

        <VerticalStackLayout Spacing="12"
                             HorizontalOptions="Fill">
            <Button Text="New Game"
                    FontSize="12"
                    Padding="4,10" 
                    Command="{Binding NewGameCommand}"
                    />
            <Button Text="Resume"
                    FontSize="12"
                    Padding="4,10"
                    Command="{Binding ResumeGameCommand}"
                    />
            <Button Text="Score History"
                    FontSize="12"
                    Padding="4,10" 
                    Command="{Binding ScoreHistoryCommand}"
                    />
            <Button Text="Exit"
                    FontSize="12"
                    Padding="4,10" 
                    Command="{Binding ExitCommand}"
                    />
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>
