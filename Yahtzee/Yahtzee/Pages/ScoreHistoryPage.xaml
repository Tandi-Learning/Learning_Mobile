<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:Yahtzee.PageModels"
             xmlns:models="clr-namespace:Yahtzee.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Yahtzee.Pages.ScoreHistoryPage"
             x:DataType="pageModels:ScoreHistoryPageModel"
             x:Name="ScoreHistoryRoot"
             Title="Score History">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior BindingContext="{Binding Path=BindingContext, Source={x:Reference ScoreHistoryRoot}, x:DataType=ContentPage}"
                                        EventName="Appearing"
                                        Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="12">
        <Label Text="Top 10 Scores"
               FontAttributes="Bold"
               FontSize="18"
               HorizontalOptions="Center" />

        <CollectionView ItemsSource="{Binding Results}"
                        EmptyView="No games recorded yet.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:GameResult">
                    <Grid ColumnDefinitions="40,*,Auto,Auto"
                          Padding="12,10"
                          BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                          Margin="0,0,0,8">
                        <Label Grid.Column="0"
                               Text="{Binding ID}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontAttributes="Bold" />
                        <Label Grid.Column="1"
                               Text="{Binding Name}"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />
                        <Label Grid.Column="2"
                               Text="{Binding Score}"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               FontAttributes="Bold"
                               Margin="0,0,12,0" />
                        <Label Grid.Column="3"
                               Text="{Binding FinishedAtDisplay}"
                               HorizontalOptions="End"
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
