root = true

[*.cs]
# Use file-scoped namespaces if you prefer
dotnet_style_namespace_match_folder = true:suggestion

# Enable StyleCop rule SA1402: file may only contain a single type
dotnet_diagnostic.SA1402.severity = error

# Treat analyzer diagnostics as errors by default to enforce rules at build time
dotnet_analyzer_diagnostic.severity = warning

# Require explicit type declarations instead of 'var'
# Set the three var-style rules to false to prefer explicit types and make them errors.
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = false:error
csharp_style_var_elsewhere = false:error

# Also ensure the compiler analyzer reports the IDE0008 diagnostic as an error when implicit 'var' is used
dotnet_diagnostic.IDE0008.severity = error

# Allow expression-bodied members when the body is a single line; longer members keep block bodies.
# These live here, not in the tests section below, so they apply to every C# file.
dotnet_style_prefer_expression_bodied_methods = when_on_single_line:suggestion
dotnet_style_prefer_expression_bodied_constructors = when_on_single_line:suggestion
dotnet_style_prefer_expression_bodied_properties = when_on_single_line:suggestion
dotnet_style_prefer_expression_bodied_indexers = when_on_single_line:suggestion
dotnet_style_prefer_expression_bodied_accessors = when_on_single_line:suggestion

# Keep the block-body diagnostics from being promoted to warnings by the default above,
# which otherwise makes a single-line expression body report IDE0022 in the IDE.
dotnet_diagnostic.IDE0022.severity = suggestion
dotnet_diagnostic.IDE0021.severity = suggestion
dotnet_diagnostic.IDE0025.severity = suggestion
dotnet_diagnostic.IDE0026.severity = suggestion
dotnet_diagnostic.IDE0027.severity = suggestion

#############
# Exceptions
#############
# Allow tests to use 'var' by making a lower-priority override for test projects
[**/Tests/*.cs]
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
dotnet_diagnostic.IDE0008.severity = warning
